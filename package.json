{
  "name": "word-duel",
  "version": "0.6.1",
  "private": true,
  "description": "A cosy real-time 1v1 turn-based word game for two phones.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test tests/logic.test.mjs tests/story-and-bonus.test.mjs tests/check-word-clients.test.mjs tests/crossword.test.mjs && node tests/word-hint.mjs",
    "test:hint": "node tests/word-hint.mjs",
    "test:live": "node tests/live-match.mjs",
    "test:live-story": "node tests/live-story.mjs",
    "test:live-race": "node tests/live-race.mjs",
    "test:live-reroll": "node tests/live-reroll.mjs",
    "test:check-word": "node tests/live-check-word.mjs",
    "screenshots": "node tests/screenshots.mjs",
    "screenshots:v05": "node tests/screenshots-v05.mjs",
    "screenshots:v06": "node tests/screenshots-v06.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "socket.io-client": "^4.8.1"
  }
}
